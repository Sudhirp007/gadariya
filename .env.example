# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL Direct / Pooler Database Connection
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Cryptography & Blind Indexing (generate 32-byte hex keys: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
ENCRYPTION_MASTER_KEY=placeholder_32_byte_hex_encryption_key
PHONE_PEPPER_KEY=placeholder_32_byte_hex_pepper_key

# Inception Labs Mercury AI (Pre-moderation & drafting)
MERCURY_API_KEY=your-mercury-api-key
MERCURY_ENABLED=true
MERCURY_BASE_URL=https://platform.inceptionlabs.ai/v1

# Transactional Email (Resend)
RESEND_API_KEY=re_placeholder
EMAIL_FROM=support@palmatrimony.in

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Authentication (Google / Firebase Phone Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
