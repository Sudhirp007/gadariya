# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cryptography & Blind Indexing (32-byte hex keys)
ENCRYPTION_MASTER_KEY=your-32-byte-hex-encryption-key
PHONE_PEPPER_KEY=your-32-byte-hex-pepper-key

# Inception Labs Mercury AI (Optional Moderation & Bio Assistant)
MERCURY_API_KEY=your-mercury-api-key
MERCURY_ENABLED=true
MERCURY_BASE_URL=https://platform.inceptionlabs.ai/v1

# Transactional Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=support@palmatrimony.in

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
